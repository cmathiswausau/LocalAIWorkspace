<Window x:Class="LocalAIWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAIWorkspace.ViewModels"
        Title="Local AI Workspace"
        Height="600"
        Width="1000">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- File list -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="*"/>
            <!-- Code -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="300"/>
            <!-- AI panel -->
        </Grid.ColumnDefinitions>

        <!-- TOP BAR -->
        <StackPanel Grid.Row="0"
            Grid.ColumnSpan="5"
            Orientation="Vertical"
            Margin="5">

            <!-- Folder A -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Select Folder A"
                Click="SelectFolder_Click"
                Width="140"
                Margin="5"/>

                <TextBlock Text="{Binding FolderAPath}"
                   Margin="5"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Folder B -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Select Folder B"
                Click="SelectFolderB_Click"
                Width="140"
                Margin="5"/>

                <TextBlock Text="{Binding FolderBPath}"
                   Margin="5"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Actions Row -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Swap -->
                <Button Content="Swap A ↔ B"
            Click="Swap_Click"
            Width="140"
            Margin="5"
            HorizontalAlignment="Left"/>

                <!-- RIGHT: Compare -->
                <Button Grid.Column="1"
            Content="Compare"
            Click="Compare_Click"
            Width="120"
            Margin="5"
            HorizontalAlignment="Right"/>
            </Grid>

        </StackPanel>
        
        

        <!-- FILE LIST -->
        <ListBox Grid.Row="1"
             Grid.Column="0"
             x:Name="FileList"
             ItemsSource="{Binding Files}"
             SelectedItem="{Binding SelectedFile}"
             DisplayMemberPath="Name"
             SelectionMode="Extended"/>

        <!-- SPLITTER 1 -->
        <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Gray"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"/>

        <!-- CODE VIEW -->
        <TextBox Grid.Row="1"
             Grid.Column="2"
             Text="{Binding FileContent}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"/>

        <!-- SPLITTER 2 -->
        <GridSplitter Grid.Row="1"
                  Grid.Column="3"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Gray"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"/>

        <!-- AI PANEL -->
        <Grid Grid.Row="1" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Content="Explain"
            Click="Explain_Click"
            Margin="5"/>

            <TextBox Grid.Row="1"
             Text="{Binding AiResponse}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="Wrap"/>
        </Grid>

    </Grid>
</Window>